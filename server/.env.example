# ===================================================================
# CANTEEN EXPRESS - ENVIRONMENT CONFIGURATION (FIREBASE & AWS)
# ===================================================================

# Server Port (Default: 5000)
PORT=5000

# -------------------------------------------------------------------
# FIREBASE CLOUD DATABASE CONFIGURATION
# -------------------------------------------------------------------
# Option A: Path to serviceAccountKey.json downloaded from Firebase Console
# (Project Settings -> Service accounts -> Generate new private key)
# Place serviceAccountKey.json in the "server" directory, or set the path below:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Direct Environment Variables (Best for AWS Elastic Beanstalk / ECS)
FIREBASE_PROJECT_ID=canteen-express-campus
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@canteen-express-campus.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...==\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://canteen-express-campus-default-rtdb.firebaseio.com

# -------------------------------------------------------------------
# AWS DEPLOYMENT SETTINGS
# -------------------------------------------------------------------
NODE_ENV=production
AWS_REGION=ap-south-1

# Set true in AWS so the container cannot start without cloud credentials.
# Keep false for local SQLite-only development.
REQUIRE_FIREBASE=false
